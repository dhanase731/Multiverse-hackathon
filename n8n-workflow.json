    {
      "parameters": {
        "promptType": "define",
        "text": "=A new email has been received.\n\nSubject: {{ $json.Subject }}\nFrom: {{ $json.From }}\nBody: {{ $json.snippet }}\n\nAnalyze this email and return the JSON object matching the required schema.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an AI Email Assistant that triages an incoming email and drafts a professional reply.\n\nReturn a single JSON object matching the required schema, with these fields:\n- intent: the category of the email.\n- priority: one of Low, Medium, High, Urgent.\n- sentiment: one of Positive, Neutral, Negative.\n- safe_to_reply: true only if the reply can be sent automatically without human review.\n- requires_human_review: true if a human should review before sending.\n- reply_subject: the subject line for the reply (usually \"Re: \" + the original subject).\n- reply_body: the complete email reply.\n- confidence: a number between 0 and 1.\n- reason: why the email should or should not be replied to automatically.\n\nReturn only the JSON object."
        }
      },
      "id": "gemini-ai-agent",
      "name": "Gemini AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        550,
        0
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "gemini-chat-model",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        500,
        180
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "gemini-creds",
          "name": "Google Gemini"
        }
      }
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"intent\": \"General Inquiry\",\n  \"priority\": \"Medium\",\n  \"sentiment\": \"Neutral\",\n  \"safe_to_reply\": true,\n  \"requires_human_review\": false,\n  \"reply_subject\": \"Re: Inquiry\",\n  \"reply_body\": \"Dear Sender,\\n\\nThank you for reaching out. We have received your inquiry.\\n\\nKind regards,\",\n  \"confidence\": 0.95,\n  \"reason\": \"Simple general greeting.\"\n}"
      },
      "id": "structured-output-parser",
